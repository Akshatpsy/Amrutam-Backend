{
    "name": "amrutam-backend",
    "version": "1.0.0",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint src/**/*.ts test/**/*.ts --no-error-on-unmatched-pattern",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "prisma:generate": "prisma generate",
        "db:seed": "prisma db seed",
        "lint:fix": "pnpm lint --fix",
        "typecheck": "tsc --noEmit",
        "format:check": "prettier --check src/**/*.ts test/**/*.ts prisma/**/*.ts",
        "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
    },
    "dependencies": {
        "@fastify/cors": "^10.0.1",
        "@fastify/helmet": "^13.0.1",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/static": "^10.1.4",
        "@fastify/view": "^12.0.0",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.0.1",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/platform-fastify": "^11.0.1",
        "@nestjs/swagger": "^11.0.3",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/auto-instrumentations-node": "^0.57.0",
        "@opentelemetry/sdk-node": "^0.57.2",
        "@prisma/client": "^6.6.0",
        "bcrypt": "^5.1.1",
        "bullmq": "^5.18.1",
        "fastify": "^5.0.0",
        "ioredis": "^5.4.1",
        "nestjs-pino": "^4.1.0",
        "pino": "^9.4.0",
        "pino-pretty": "^11.2.2",
        "prisma": "^6.6.0",
        "prom-client": "^15.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "uuid": "^11.0.3",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@types/bcrypt": "^5.0.2",
        "@types/node": "^22.10.1",
        "@types/supertest": "^6.0.2",
        "@vitest/coverage-v8": "^2.1.9",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-import": "^2.31.0",
        "globals": "^17.12.0",
        "prettier": "^3.4.2",
        "supertest": "^7.0.0",
        "ts-node": "^10.9.2",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.70.0",
        "vitest": "^2.1.8"
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "packageManager": "pnpm@9.15.0"
}
